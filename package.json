{
  "name": "bureaucracy-as-code",
  "version": "0.1.0",
  "private": false,
  "description": "Browser-only bureaucracy-as-code demo for Romanian Law 544/2001 transparency workflows.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "ledger:compile": "hardhat compile",
    "ledger:test": "hardhat test test/hardhat/Law544Ledger.ts test/hardhat/Law544LedgerIndexer.ts",
    "ledger:node": "hardhat node",
    "ledger:deploy": "hardhat run scripts/deploy-law544-ledger.ts",
    "privacy:scan": "node scripts/scan-pii-fixtures.mjs",
    "verify": "node scripts/verify-local.mjs",
    "verify:e2e": "RUN_E2E=1 node scripts/verify-local.mjs",
    "demo:verify": "node scripts/verify-browser-demo.mjs",
    "security:gitleaks": "gitleaks detect --source . --verbose"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.3.0",
    "hardhat": "^3.16.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CristianNichifor/bureaucracy-as-code.git"
  },
  "homepage": "https://digital.cristian-nichifor.com/bureaucracy-as-code"
}
